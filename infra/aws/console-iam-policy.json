{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "JayTraceConsoleListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_JAYTRACE_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "YOUR_JAYTRACE_PREFIX",
            "YOUR_JAYTRACE_PREFIX/*"
          ]
        }
      }
    },
    {
      "Sid": "JayTraceConsoleReadObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::YOUR_JAYTRACE_BUCKET/YOUR_JAYTRACE_PREFIX/*"
    },
    {
      "Sid": "JayTraceConsoleWriteIssueStates",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::YOUR_JAYTRACE_BUCKET/YOUR_JAYTRACE_PREFIX/_state/issues/*"
    }
  ]
}
