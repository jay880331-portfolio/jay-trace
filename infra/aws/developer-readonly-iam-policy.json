{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "JayTraceListBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::YOUR_JAYTRACE_BUCKET"
    },
    {
      "Sid": "JayTraceReadObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::YOUR_JAYTRACE_BUCKET/*"
    }
  ]
}
