{
  "name": "@jaytrace/example-nest-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && node --env-file=.env dist/main.js",
    "start": "node --env-file=.env dist/main.js",
    "retention": "node --env-file=.env dist/jaytrace-retention-cli.js",
    "test": "pnpm build && node dist/self-check.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@jaytrace/nestjs": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "mysql2": "^3.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.7.3"
  }
}
