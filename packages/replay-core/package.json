{
  "name": "@jaytrace/replay-core",
  "version": "0.1.0",
  "description": "Shared JayTrace replay document types, ring buffer, and masking helpers.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm exec esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --outfile=dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node dist/self-check.js"
  },
  "dependencies": {
    "@jaytrace/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaytrace/packages.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
