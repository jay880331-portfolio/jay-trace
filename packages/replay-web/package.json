{
  "name": "@jaytrace/replay-web",
  "version": "0.1.0",
  "description": "JayTrace lightweight event-based session replay for Web, React, and Next.js.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @jaytrace/replay-core build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @jaytrace/replay-core build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node dist/self-check.js"
  },
  "dependencies": {
    "@jaytrace/replay-core": "workspace:*",
    "rrweb": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaytrace/packages.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
