{
  "name": "@jaytrace/browser",
  "version": "0.1.1",
  "description": "JayTrace browser RUM SDK with one-line init, trace propagation, and AI-readable timeline buffering.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./next/rum-route": {
      "types": "./dist/next-rum-route.d.ts",
      "default": "./dist/next-rum-route.js"
    },
    "./next/server": {
      "types": "./dist/next-server.d.ts",
      "default": "./dist/next-server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @jaytrace/core build && pnpm --filter @jaytrace/replay-web build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @jaytrace/core build && pnpm --filter @jaytrace/replay-web build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node dist/self-check.js"
  },
  "dependencies": {
    "@jaytrace/core": "workspace:*",
    "@jaytrace/replay-core": "workspace:*",
    "@jaytrace/replay-web": "workspace:*"
  },
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaytrace/packages.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
